{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "allowImportingTsExtensions": true,
    "types": ["node", "bun"]
  },
  "include": ["index.ts", "server.ts", "tui.tsx", "rpc.ts", "src", "test", "scripts"]
}
